#version 450
/* a[i] += b[i] */
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer ABuf { float a[]; };
layout(set = 0, binding = 1) readonly buffer BBuf { float b[]; };
layout(set = 0, binding = 2) readonly buffer Unused { float u[]; };

layout(push_constant) uniform Push {
    uint n;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        a[i] += b[i];
}
