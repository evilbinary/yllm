#version 450
/* Q4_K gemv: 每 workgroup 一行. 32 线程各吃一组 32 元, 再 shared 归约.
 * qs 按 uint 取字节, 避免逐 byte 的 w[] 下标. */
layout(local_size_x = 32) in;

layout(set = 0, binding = 0) readonly buffer InX { float x[]; };
layout(set = 0, binding = 1) writeonly buffer OutY { float y[]; };
layout(set = 0, binding = 2) readonly buffer InW { uint w[]; };

layout(push_constant) uniform Push {
    uint out_n;
    uint in_n;
    uint w_off;
    uint serial;
} pc;

uint load_u8(uint off)
{
    uint word = w[off >> 2u];
    return (word >> ((off & 3u) * 8u)) & 0xFFu;
}

float load_f16(uint off)
{
    uint u = w[off >> 2u];
    if ((off & 2u) != 0u) u >>= 16u;
    return unpackHalf2x16(u).x;
}

void scale_min(uint g, uint scp, out uint sc, out uint mn)
{
    if (g < 4u) {
        sc = load_u8(scp + g) & 63u;
        mn = load_u8(scp + g + 4u) & 63u;
    } else {
        sc = (load_u8(scp + g + 4u) & 15u) | ((load_u8(scp + g - 4u) >> 6u) << 4u);
        mn = (load_u8(scp + g + 4u) >> 4u) | ((load_u8(scp + g) >> 6u) << 4u);
    }
}

float q4k_dot256(uint blk, uint xoff)
{
    float d = load_f16(blk);
    float dmin = load_f16(blk + 2u);
    uint scp = blk + 4u;
    uint qs = blk + 16u;
    float acc = 0.0;
    for (uint g = 0u; g < 8u; g++) {
        uint sc, mn;
        scale_min(g, scp, sc, mn);
        float d1 = d * float(sc);
        float m1 = dmin * float(mn);
        uint q = qs + (g >> 1u) * 32u;
        uint xbase = xoff + g * 32u;
        for (uint e = 0u; e < 32u; e += 4u) {
            uint packed = w[(q + e) >> 2u];
            uint shift = ((g & 1u) != 0u) ? 4u : 0u;
            acc += x[xbase + e] * (d1 * float((packed >> shift) & 15u) - m1);
            acc += x[xbase + e + 1u] * (d1 * float((packed >> (8u + shift)) & 15u) - m1);
            acc += x[xbase + e + 2u] * (d1 * float((packed >> (16u + shift)) & 15u) - m1);
            acc += x[xbase + e + 3u] * (d1 * float((packed >> (24u + shift)) & 15u) - m1);
        }
    }
    return acc;
}

/* 线程 lid 对每个 256 块处理 8 个 group 里下标 lid 的那一列 */
float q4k_lane(uint row, uint nb, uint lid)
{
    float acc = 0.0;
    for (uint b = 0u; b < nb; b++) {
        uint blk = row + b * 144u;
        uint xoff = b * 256u;
        float d = load_f16(blk);
        float dmin = load_f16(blk + 2u);
        uint scp = blk + 4u;
        uint qs = blk + 16u;
        for (uint g = 0u; g < 8u; g++) {
            uint sc, mn;
            scale_min(g, scp, sc, mn);
            float d1 = d * float(sc);
            float m1 = dmin * float(mn);
            uint byte_off = qs + (g >> 1u) * 32u + lid;
            uint packed = w[byte_off >> 2u];
            uint nib = (packed >> ((byte_off & 3u) * 8u)) & 0xFFu;
            nib = ((g & 1u) != 0u) ? (nib >> 4u) : (nib & 15u);
            acc += x[xoff + g * 32u + lid] * (d1 * float(nib) - m1);
        }
    }
    return acc;
}

shared float sh[32];

void main()
{
    uint o = gl_WorkGroupID.x;
    if (o >= pc.out_n) return;

    uint nb = pc.in_n / 256u;
    uint rowb = nb * 144u;
    uint row = pc.w_off + o * rowb;
    uint lid = gl_LocalInvocationID.x;

    if (pc.serial != 0u) {
        if (lid == 0u) {
            float acc = 0.0;
            for (uint b = 0u; b < nb; b++)
                acc += q4k_dot256(row + b * 144u, b * 256u);
            y[o] = acc;
        }
        return;
    }

    sh[lid] = q4k_lane(row, nb, lid);
    memoryBarrierShared();
    barrier();
    if (lid == 0u) {
        float s = 0.0;
        for (uint i = 0u; i < 32u; i++)
            s += sh[i];
        y[o] = s;
    }
}
