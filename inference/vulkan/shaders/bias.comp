#version 450
/* v[i] += bias[bias_off + i] */
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer VBuf { float v[]; };
layout(set = 0, binding = 1) readonly buffer BiasBuf { float bias[]; };
layout(set = 0, binding = 2) readonly buffer Unused { float u[]; };

layout(push_constant) uniform Push {
    uint n;
    uint bias_off;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        v[i] += bias[pc.bias_off + i];
}
