#version 450
/* d[dst_off + i] = s[i]  — 写 KV 行 */
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer SrcBuf { float s[]; };
layout(set = 0, binding = 1) buffer DstBuf { float d[]; };
layout(set = 0, binding = 2) readonly buffer Unused { float u[]; };

layout(push_constant) uniform Push {
    uint n;
    uint dst_off; /* float 元素偏移 */
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        d[pc.dst_off + i] = s[i];
}
