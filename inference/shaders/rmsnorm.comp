#version 450
/* 占位: 逐元素 y=x*w（非真 rmsnorm）。接入引擎前仅用于验证 glslc 流水线。 */
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer InBuf { float x[]; };
layout(set = 0, binding = 1) writeonly buffer OutBuf { float y[]; };
layout(set = 0, binding = 2) readonly buffer WBuf { float w[]; };
layout(push_constant) uniform Push { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        y[i] = x[i] * w[i];
}
